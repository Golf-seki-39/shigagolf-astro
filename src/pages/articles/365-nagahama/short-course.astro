---
// --- [1] AstroとFirebaseの基本設定 ---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { db } from "../../../lib/firebase.js";
import { doc, getDoc } from "firebase/firestore";
import { Image } from "astro:assets";
import Sidebar from '../../../components/Sidebar.astro'; 

// --- [2] 共通コンポーネントをインポート ---
import MySlider from '../../../components/MySlider.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import AuthorProfile from '../../../components/AuthorProfile.astro';

// --- [3] この記事固有の情報 ---
const imageUrl = "https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6583.jpeg";

const title = "365ゴルフクラブながはまのショートコース｜料金・予約・一人ラウンド・攻略法を実体験レビュー | シガゴル";
const description = "滋賀県長浜市の「365ゴルフクラブ」ショートコース体験記。予約不要で当日一人利用もOK！1,780円〜の「練習1時間＋9H」セット料金や、18H・27Hの追加費用、池越えホールの攻略法、必要な持ち物まで徹底解説します。";
const category = "体験談";
const pubDate = "2025-11-14"; 
const pubDateISO = "2025-11-14T17:00:00+09:00"; 
const updatedDate = "2026-09-24"; 
const updatedDateISO = "2026-09-24T17:00:00+09:00";
const rangeId = "365_nagahama"; 

// --- [4] シェアボタン用の変数を定義 ---
const baseUrl = "https://shigagolf.com"; 
const articleUrl = `${baseUrl}/articles/365-nagahama/short-course/`; 
const headline = "365ゴルフクラブながはまのショートコース｜料金・予約・一人ラウンド・攻略法を実体験レビュー";

// --- [5] Firebaseから練習場データを取得 ---
const appId = import.meta.env.PUBLIC_FIREBASE_APP_ID;
const docPath = `artifacts/${appId}/public/data/practice_ranges/${rangeId}`;
const docRef = doc(db, docPath);
const docSnap = await getDoc(docRef);
let rangeData = null;
if (docSnap.exists()) {
    rangeData = docSnap.data();
} else {
    console.error(`Error: No document found for rangeId: ${rangeId}`);
}

// --- [6] 関連記事リストの定義 ---
const experienceReports = [
    { url: '/articles/365-nagahama/range/', title: '【体験談①】365ながはま(練習場) 体験レポート', img: 'https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/image_archive/gallery/0000ai.jpg' },    
    { url: '/articles/shiga-short-courses/', title: '滋賀県のショートコース徹底比較！おすすめ施設まとめ', img: 'https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/image_archive/gallery/0000aishort.jpg' },
    { url: '/articles/review/365hikone/', title: '365ゴルフクラブ 彦根 体験レポート', img: 'https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_hikone/gallery/0000img.jpg' },
    { url: '/articles/taga-golf/', title: '多賀ゴルフ練習場 体験レポート', img: 'https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/taga_gr/gallery/aikyatti-taga.png' },
    { url: '/articles/ksp-hikone-review/', title: 'KSP彦根 体験レポート', img: 'https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/ksp_hikone/gallery/000000img.png' }
];

// --- [7] ショートコース料金データ ---
const priceData = {
  setPlan: [
    { type: 'メンバー（全日）', price: 1480, add: 300 },
    { type: 'ビジター (平日)', price: 1780, add: 500 },
    { type: 'ビジター (土日祝)', price: 1980, add: 500 }
  ],
  soloPlan: [
    { type: 'メンバー (全日)', price: 980, add: 300 },
    { type: 'ビジター (平日)', price: 1280, add: 500 },
    { type: 'ビジター (土日祝)', price: 1480, add: 500 },
    { type: 'ジュニア (メンバー)', price: 780, add: 300 },
    { type: 'ジュニア (ビジター)', price: 980, add: 500 }
  ]
};
---

<script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "image": [imageUrl],
    "datePublished": pubDateISO,
    "dateModified": updatedDateISO,
    "author": [{
        "@type": "Person",
        "name": "関＠シガゴル管理人",
        "url": `${baseUrl}/`
    }],
    "publisher": {
        "@type": "Organization",
        "name": "シガゴル",
        "logo": {
            "@type": "ImageObject",
            "url": `${baseUrl}/logo.png`
        }
    },
    "description": description
})} />

<BaseLayout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} ogImage={imageUrl}>
    
     <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col lg:flex-row gap-8 items-stretch my-8">

        <main id="article-view" class="w-full lg:flex-1 bg-white p-6 md:p-8 rounded-lg shadow-lg text-slate-700 leading-relaxed overflow-hidden">

            <a href="/articles/" class="nav-link back-button mb-6 inline-block text-green-700 font-semibold hover:underline">
                ‹ お役立ち記事一覧に戻る
            </a>
            
            <style is:global>
              html { scroll-behavior: smooth; }
              section[id], h2[id] { scroll-margin-top: 80px; }
               .table-wrapper { overflow-x: auto; }
               .min-w-table-pc { min-width: 600px; }
               .table-wrapper th:first-child, .table-wrapper td:first-child { position: -webkit-sticky; position: sticky; left: 0; z-index: 10; }
               .table-wrapper thead th:first-child { background-color: #f1f5f9; }
               .table-wrapper tbody tr.bg-white td:first-child { background-color: #ffffff; }
               .table-wrapper tbody tr.bg-slate-50 td:first-child { background-color: #f8fafc; }
            </style>
            
            <header>
                <h1 class="text-3xl md:text-4xl font-bold text-slate-800">{headline}</h1>
                <div class="text-sm text-slate-500 mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <span>公開日：{pubDate}</span>
                    {updatedDate && (
                        <span class="flex items-center gap-1 text-slate-600 font-semibold bg-slate-100 px-2 py-1 rounded">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            更新日：{updatedDate}
                        </span>
                    )}
                </div>
            </header>

            <div class="summary-box bg-slate-50 p-6 rounded-lg border border-slate-200 my-8 not-prose">
                 <h2 class="text-xl font-bold mb-4 text-slate-800 border-b border-slate-300 pb-2">
                    一目でわかる！365ゴルフクラブながはま ショートコース概要
                 </h2>
                 <ul class="space-y-3 text-slate-700">
                    <li class="flex items-start"><span class="mr-2">📍</span> <strong>場所:</strong> 滋賀県長浜市（練習場併設）</li>
                    <li class="flex items-start"><span class="mr-2">💰</span> <strong>料金:</strong> 9H 1,280円〜 / 練習1h＋9Hセット 1,780円〜</li>
                    <li class="flex items-start"><span class="mr-2">📅</span> <strong>予約:</strong> <strong>予約不要（当日受付のみ）</strong></li>
                    <li class="flex items-start"><span class="mr-2">👤</span> <strong>一人利用:</strong> <strong>OK</strong>（一人で利用する人も多いです）</li>
                    <li class="flex items-start"><span class="mr-2">🌙</span> <strong>ナイター:</strong> 公式案内では夜21:30頃まで利用可能</li>
                    <li class="flex items-start"><span class="mr-2">⛳️</span> <strong>コース:</strong> 全9ホール（人工芝グリーン・池越えあり）</li>
                 </ul>
            </div>

            <p>先日公開した<a href="/articles/365-nagahama/range/" class="text-green-700 hover:underline">練習場編の記事</a>で、僕はここを“完璧なホーム”と呼びました。<br class="md:hidden" />その最大の理由こそが、この<strong>「本格9Hショートコース」</strong>の存在です。</p>
            <p>この記事では、気になる料金プラン（18Hや27H回ったらいくらになるか）、予約や一人利用の実態、そして初心者が注意すべきホールの攻略法まで徹底的に解説します。</p>
            
            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6583.jpeg"} 
                    alt="365ゴルフクラブ ながはま ショートコースの池越えホール" 
                    class="w-full h-auto object-cover rounded-lg" 
                    loading="eager" 
                    fetchpriority="high" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900} 
                />
            </figure>

            <div class="toc-container bg-green-50 p-6 rounded-lg border border-green-200 my-8 not-prose">
                <h2 class="text-xl font-bold mb-4 text-green-800">この記事の目次</h2>
                <ul class="space-y-2 list-disc list-inside text-green-900">
                    <li><a href="#price" class="hover:underline">① 365ゴルフクラブながはま ショートコースの料金表（18H・27H目安）</a></li>
                    <li><a href="#reservation-solo" class="hover:underline">② 予約は必要？一人ラウンドはできる？</a></li>
                    <li><a href="#strategy" class="hover:underline">③ 365ゴルフクラブながはまの攻略法｜初心者が注意したい3ホール</a></li>
                    <li><a href="#belongings" class="hover:underline">④ 初めて行く人へ｜服装・持ち物・回り方について</a></li>
                    <li><a href="#facilities" class="hover:underline">⑤ 設備情報（ナイター・ロッカー・セルフバッグ）</a></li>
                    <li><a href="#conclusion" class="hover:underline">⑥ まとめ：ここが僕の「上達の黄金サイクル」</a></li>
                </ul>
            </div>

            <h2 id="price" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ① 365ゴルフクラブながはま ショートコースの料金表
            </h2>
            
            <p class="text-lg font-bold text-slate-800 bg-yellow-50 p-4 rounded-lg border border-yellow-200 mb-6">
                ビジターなら、ショートコース9Hのみは平日1,280円、練習1時間＋9Hなら1,780円。さらに9H追加するごとに平日500円で、18Hなら2,280円、27Hなら2,780円です。
            </p>

            <p>結論から言うと、<strong>「1時間打ち放題＋ショートコース9H」のセットプランが圧倒的にお得</strong>です。<br/>僕もこのセットを利用し、時間の許す限り「ハーフ追加（9H）」をして楽しむことが多いです。</p>

            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6605.jpg"} 
                    alt="365ゴルフクラブ ながはま ショートコース 料金表" 
                    class="w-full h-auto object-cover rounded-lg my-4" 
                    loading="lazy" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900}
                    decoding="async"
                />
                <figcaption class="text-center text-sm text-slate-500 mt-2">最強のセットプラン。※プリカなくてもOK。現金キャッシュレス対応</figcaption>
            </figure>
            
            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">【早見表】9H・18H・27H 回った場合の料金目安</h3>
            <p>「結局、半日ガッツリ回ったらいくらになるの？」という疑問にお答えするため、ビジター（平日）とメンバーでシミュレーションしてみました。</p>

            <div class="table-wrapper my-6 not-prose">
                <table class="w-full text-left border-collapse responsive-table min-w-table-pc">
                    <thead class="bg-slate-100 border-t-2 border-slate-300">
                        <tr>
                            <th class="py-3 px-4 font-semibold border-b">プラン</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">9H</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">18H (追加1回)</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">27H (追加2回)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-slate-200 bg-white">
                            <th class="py-3 px-4 font-semibold">ビジター平日 (ショートのみ)</th>
                            <td class="py-3 px-4 text-center">1,280円</td>
                            <td class="py-3 px-4 text-center">1,780円</td>
                            <td class="py-3 px-4 text-center">2,280円</td>
                        </tr>
                        <tr class="border-b border-slate-200 bg-slate-50">
                            <th class="py-3 px-4 font-semibold text-green-700">★ビジター平日 (練習1h＋)</th>
                            <td class="py-3 px-4 text-center font-bold text-green-700">1,780円</td>
                            <td class="py-3 px-4 text-center font-bold text-green-700">2,280円</td>
                            <td class="py-3 px-4 text-center font-bold text-green-700">2,780円</td>
                        </tr>
                        <tr class="border-b border-slate-200 bg-white">
                            <th class="py-3 px-4 font-semibold">メンバー (練習1h＋)</th>
                            <td class="py-3 px-4 text-center">1,480円</td>
                            <td class="py-3 px-4 text-center">1,780円</td>
                            <td class="py-3 px-4 text-center">2,080円</td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-sm text-slate-500 mt-2">※追加ハーフ料金：ビジター500円 / メンバー300円。<br/>※混雑状況により追加ラウンドの受付が制限される場合があります。詳細はフロントでご確認ください。</p>
            </div>

            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">基本料金プラン一覧</h3>
            
            <h4 class="text-lg font-bold text-slate-800 mt-6 mb-2">練習1時間＋9H セット</h4>
            <div class="table-wrapper my-4 not-prose hidden md:block">
                <table class="w-full text-left border-collapse responsive-table min-w-table-pc">
                    <thead class="bg-slate-100">
                        <tr>
                            <th class="py-3 px-4 font-semibold border-b">対象</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">セット料金 (練習1h+9H)</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">追加 9Hごと</th>
                        </tr>
                    </thead>
                    <tbody>
                        {priceData.setPlan.map((plan, index) => (
                             <tr class={`border-b border-slate-200 ${index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
                                <th class="py-3 px-4 font-semibold">{plan.type}</th>
                                <td data-label="セット料金" class="py-3 px-4 text-center"><strong>{plan.price.toLocaleString()}円</strong></td>
                                <td data-label="追加9H" class="py-3 px-4 text-center"><strong>{plan.add.toLocaleString()}円</strong></td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <div class="my-4 space-y-4 md:hidden not-prose">
                {priceData.setPlan.map(plan => (
                    <div class="border border-slate-200 rounded-lg overflow-hidden shadow-sm">
                        <h4 class="text-lg font-bold p-3 bg-slate-50">{plan.type}</h4>
                        <div class="p-4 space-y-3">
                            <div class="flex justify-between items-baseline">
                                <span class="text-slate-600 text-sm">セット料金 (練習1h+9H)</span>
                                <strong class="text-xl text-green-700">{plan.price.toLocaleString()}円</strong>
                            </div>
                            <div class="flex justify-between items-baseline border-t border-slate-200 pt-3">
                                <span class="text-slate-600 text-sm">追加 9Hごと</span>
                                <strong class="text-xl text-green-700">{plan.add.toLocaleString()}円</strong>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <h4 class="text-lg font-bold text-slate-800 mt-8 mb-2">ショートコースのみ (9H)</h4>
            <div class="table-wrapper my-4 not-prose hidden md:block">
                <table class="w-full text-left border-collapse responsive-table min-w-table-pc">
                    <thead class="bg-slate-100">
                        <tr>
                            <th class="py-3 px-4 font-semibold border-b">対象</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">基本料金 (9H)</th>
                            <th class="py-3 px-4 font-semibold border-b text-center">追加 9Hごと</th>
                        </tr>
                    </thead>
                    <tbody>
                        {priceData.soloPlan.map((plan, index) => (
                            <tr class={`border-b border-slate-200 ${index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}`}>
                                <th class="py-3 px-4 font-semibold">{plan.type}</th>
                                <td data-label="基本料金" class="py-3 px-4 text-center"><strong>{plan.price.toLocaleString()}円</strong></td>
                                <td data-label="追加9H" class="py-3 px-4 text-center"><strong>{plan.add.toLocaleString()}円</strong></td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <div class="my-4 space-y-4 md:hidden not-prose">
                {priceData.soloPlan.map(plan => (
                    <div class="border border-slate-200 rounded-lg overflow-hidden shadow-sm">
                        <h4 class="text-lg font-bold p-3 bg-slate-50">{plan.type}</h4>
                        <div class="p-4 space-y-3">
                            <div class="flex justify-between items-baseline">
                                <span class="text-slate-600 text-sm">基本料金 (9H)</span>
                                <strong class="text-xl text-green-700">{plan.price.toLocaleString()}円</strong>
                            </div>
                            <div class="flex justify-between items-baseline border-t border-slate-200 pt-3">
                                <span class="text-slate-600 text-sm">追加 9Hごと</span>
                                <strong class="text-xl text-green-700">{plan.add.toLocaleString()}円</strong>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <h2 id="reservation-solo" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ② 予約は必要？一人ラウンドはできる？
            </h2>
            
            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">ショートコースは「完全予約不要」</h3>
            <p>365ゴルフクラブながはまのショートコースは、<strong>事前の予約は一切不要</strong>です。<br/>当日、練習場のフロントに行き、「ショートコース回りたいです」と伝えて申し込み用紙に名前を書くだけで受付完了です。思い立ったその日にふらっと行ける手軽さが最大の魅力です。</p>

            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">一人ラウンド（1人利用）もOK！</h3>
            <p>「ショートコースに一人で行っても大丈夫かな…？」と不安な方、安心してください。<strong>ここは一人ラウンドしやすい環境です。</strong></p>
            <p>実際、一人で回っているゴルファーをよく見かけます。本コースのように後続組から急かされるようなプレッシャーも少なく、自分のペースで落ち着いて回りやすい雰囲気があります。</p>
            
            <div class="not-prose bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded-r-lg my-6">
                <h4 class="text-lg font-bold text-yellow-800 mt-0 mb-2">💡 空いている時限定！「一人二役」練習法</h4>
                <p class="m-0 text-slate-700 mb-3">
                    完全に後ろが詰まっていない空き時間帯に限りますが、<strong>「1人で2球使ったマネジメント練習（一人二役）」</strong>もおすすめです。<br/>
                    ・1球目：いつものクラブで本気で狙う<br/>
                    ・2球目：番手を変えたり、あえてパターで寄せてみる<br/>
                    本番のコースでは絶対にできないこの“実戦練習”ができるのは、気軽に回れるショートコースならではの特権です。
                </p>
                <p class="m-0 text-sm font-bold text-red-600">
                    ※他の利用者がいる場合は、必ず施設のルールや周囲の状況を優先してください。
                </p>
            </div>

            <h2 id="strategy" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ③ 365ゴルフクラブながはまの攻略法｜初心者が注意したい3ホール
            </h2>

            <p>「どうせ練習場併設のコースでしょ」と侮ってはいけません。グリーンの状態は手入れされた人工芝（ベント風）で、<strong>公式案内では9.5フィート。実際にプレーした僕の体感では、数字ほど速くは感じませんでした</strong>（※特に5番ホールは速いので注意）。傾斜もしっかりあり実践的です。</p>
            <p>ここでは、初心者がスコアを崩しやすい戦略的な3つのホールを解説します。</p>

            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6592.jpg"} 
                    alt="ショートコースのグリーンの状態（人工芝）" 
                    class="w-full h-auto object-cover rounded-lg my-4" 
                    loading="lazy" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900}
                    decoding="async"
                />
                <figcaption class="text-center text-sm text-slate-500 mt-2">手入れされた人工芝。体感では少し遅めですが、5番は速いので注意。</figcaption>
            </figure>

            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6578.jpg"} 
                    alt="ショートコースの各ホール距離一覧表" 
                    class="w-full h-auto object-cover rounded-lg my-4" 
                    loading="lazy" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900}
                    decoding="async"
                />
                <figcaption class="text-center text-sm text-slate-500 mt-2">2周目は1番〜9番を別ティーから回るため、距離が変化します。</figcaption>
            </figure>

            <div class="space-y-8 my-8">
                <div>
                    <h4 class="text-xl font-bold text-green-800 mb-2 border-l-4 border-green-600 pl-3">1番ホール：いきなりの池越え</h4>
                    <Image 
                        src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6583.jpeg"} 
                        alt="1番ホールの池越え" 
                        class="w-full h-auto object-cover rounded-lg my-4" 
                        loading="lazy" 
                        format="webp" 
                        quality={80}
                        width={1200}
                        height={900}
                        decoding="async"
                    />
                    <p>スタートホールからいきなりの池越えでメンタルが試されます。距離は短いので、力まずリラックスしてクラブを振り抜くことだけを意識しましょう。</p>
                </div>
                
                <div>
                    <h4 class="text-xl font-bold text-green-800 mb-2 border-l-4 border-green-600 pl-3">3番ホール：池越え＋2段グリーンの最難関</h4>
                    <Image 
                        src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/030000010.png"} 
                        alt="3番ホールの写真" 
                        class="w-full h-auto object-cover rounded-lg my-4" 
                        loading="lazy" 
                        format="webp" 
                        quality={80}
                        width={1200}
                        height={900}
                        decoding="async"
                    />
                    <p>池を越えればすぐグリーンですが、問題はグリーンが「2段」になっていること。池が怖い人は、ピンポイントで距離を合わせるより、<strong>「グリーンちょいオーバー」を狙うのが安牌（安全策）</strong>です。グリーン奥は傾斜を登ってフェンスなので助かります。ただし、オーバーしすぎると強烈な左足下がりのアプローチが残ります。</p>
                </div>

                <div>
                    <h4 class="text-xl font-bold text-green-800 mb-2 border-l-4 border-green-600 pl-3">4番ホール：奥に外すのは絶対にダメ</h4>
                    <p>グリーンをオーバーすると、強い傾斜でボールがこぼれ落ちます。場所によっては旗すら見えなくなるため、ここは<strong>「絶対に手前から攻める」</strong>のが鉄則です。</p>
                </div>
            </div>

            <h2 id="belongings" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ④ 初めて行く人へ｜服装・持ち物・回り方について
            </h2>
            <p>ショートコースは本コース（18ホール）ほど厳格なドレスコードはありません。動きやすい服装が基本です。靴については、施設側もスニーカーでのプレーをOKとしてくれています。僕はいつも運動靴でプレーしています。</p>
            <ul class="list-disc list-inside space-y-2 mt-4 mb-6">
                <li><strong>必要なクラブ:</strong> ショートコースなので、ウェッジ・パターを中心に数本でも楽しめます。初めてなら普段使っているクラブを必要な範囲で持っていけばOKです。</li>
                <li><strong>ボール・ティー:</strong> 練習用ではなく、コース用ボール（ロストボールで十分）を数個持参しましょう。</li>
            </ul>
            
            <div class="not-prose p-6 bg-slate-50 border border-slate-200 rounded-lg text-center mt-6">
                <h4 class="text-lg font-bold text-slate-800 mb-2">ショートコースデビューを完璧にしたい方へ</h4>
                <p class="text-slate-600 mb-4">「必要な持ち物」や「一人ラウンドの手順・マナー」について、別記事で詳しくまとめています。</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/articles/short-course-belongings/" class="inline-block bg-white border border-green-600 text-green-700 font-bold py-2 px-6 rounded hover:bg-green-50 transition-colors">
                        必要な持ち物を確認する →
                    </a>
                    <a href="/articles/short-course-guide/" class="inline-block bg-white border border-green-600 text-green-700 font-bold py-2 px-6 rounded hover:bg-green-50 transition-colors">
                        一人での回り方を確認する →
                    </a>
                </div>
            </div>

            <h2 id="facilities" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ⑤ 設備情報（ナイター・ロッカー・セルフバッグ）
            </h2>
            
            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">ナイター完備で21:30までプレー可能</h3>
            <p>365ながはまのショートコースにはナイター設備があり、<strong>公式案内では夜21:30頃まで利用可能とされています。</strong>仕事帰りに「打ちっぱなし＋ハーフ」なんていう、夢のようなゴルフライフも実現できます。</p>
            
            <div class="not-prose bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg my-4">
                <h4 class="text-lg font-bold text-blue-800 mt-0 mb-2">【僕の正直レビュー】</h4>
                <p class="m-0 text-slate-700">
                    （※正直に告白すると、僕はいつも昼〜夕方に行ってしまうためナイター未体験です！近いうちに体験して追記しますね。）
                </p>
            </div>

            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">無料の貴重品ロッカー＆セルフバッグ貸出</h3>
            
            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6576.png"} 
                    alt="ショートコース受付用のテーブル" 
                    class="w-full h-auto object-cover rounded-lg my-4" 
                    loading="lazy" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900}
                    decoding="async"
                />
                <figcaption class="text-center text-sm text-slate-500 mt-2">受付横の休憩所。ここで申し込み用紙を書きます。</figcaption>
            </figure>

            <p>受付横に<strong>無料のセルフバッグ（サブバッグ）</strong>が大量に置いてあります。重いキャディバッグを担ぐ必要はなく、身軽にラウンドできます。</p>
            <p>また、貴重品ロッカーも完備。受付でロッカーを使うか聞かれます。使うと伝えると100円玉を渡してくれて、それを使ってロッカーを利用する仕組みです（無料）。</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6 not-prose">
                 <figure>
                    <Image 
                        src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6579.jpg"} 
                        alt="無料の貴重品ロッカー" 
                        class="w-full h-auto object-cover rounded-lg" 
                        loading="lazy" 
                        format="webp" 
                        quality={80} 
                        width={1200} 
                        height={900} 
                        decoding="async" 
                    />
                    <figcaption class="text-center text-sm text-slate-500 mt-2">100円返却式の貴重品ロッカー</figcaption>
                 </figure>
                 <figure>
                    <Image 
                        src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6582.png"} 
                        alt="無料のセルフバッグ" 
                        class="w-full h-auto object-cover rounded-lg" 
                        loading="lazy" 
                        format="webp" 
                        quality={80} 
                        width={1200} 
                        height={900} 
                        decoding="async" 
                    />
                    <figcaption class="text-center text-sm text-slate-500 mt-2">無料のセルフバッグ</figcaption>
                 </figure>
            </div>
            
            <h3 class="text-xl font-bold text-slate-800 mt-8 mb-3">ナビ：「NEXT TEE」看板で迷わない</h3>
            <p>また、コース内には「NEXT TEE →」という案内看板がしっかり設置されているため、初めてでも迷うことなく進行できます。</p>
            
            <figure class="my-6">
                <Image 
                    src={"https://storage.googleapis.com/shigagolf-e31e6.firebasestorage.app/practice_ranges/365_nagahama/gallery/IMG_6590.png"} 
                    alt="NEXT TEEの案内看板" 
                    class="w-full h-auto object-cover rounded-lg my-4" 
                    loading="lazy" 
                    format="webp" 
                    quality={80}
                    width={1200}
                    height={900}
                    decoding="async"
                />
            </figure>

            <h2 id="conclusion" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4 border-b-2 border-green-600 pb-2">
                ⑥ まとめ：ここが僕の「上達の黄金サイクル」
            </h2>
            <p>なぜ僕が、家から近い練習場を素通りしてまでここへ通うのか。それは、この場所で<strong>「上達の黄金サイクル」</strong>が完結するからです。</p>
            
            <ol class="list-decimal list-inside space-y-2 mt-4 mb-6 prose">
                <li><a href="/articles/365-nagahama/range/" class="text-green-700 hover:underline"><strong>【練習場】</strong></a>でトップトレーサーを使い、ショットの課題を明確にする。</li>
                <li><strong>【バンカー/パター】</strong>練習場で、スコアメイクの技術を磨く。</li>
                <li><strong>【ショートコース】</strong>で、プレッシャーゼロの中「一人二役」をしながら、①②の課題を“実戦”で試す。</li>
            </ol>
            
            <p>このサイクルを1箇所で回せる環境は、僕がこれまで滋賀県の練習場やショートコースを見てきた中でも、かなり貴重だと感じています。<br/>あなたもぜひ、この“完璧なホーム”で、ゴルフが上達する喜びを体験してみてください。</p>
            
            <div class="not-prose my-12 space-y-12">
                <MySlider articles={experienceReports} title="あわせて読みたい記事"/>
            </div>

            <ShareButtons articleUrl={articleUrl} headline={headline} />
            <AuthorProfile />
            
            <h2 id="info-summary" class="scroll-mt-24 text-2xl md:text-3xl font-bold text-slate-800 mt-12 mb-4">
                {rangeData ? `「${rangeData.name}」の基本情報` : "「365ゴルフクラブ ながはま」の基本情報"}
            </h2>
            {
                rangeData ? (
                    <div class="overflow-x-auto not-prose">
                        <table class="w-full text-left border-collapse">
                            <tbody>
                                <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold w-1/3">施設名</th>
                                    <td class="py-3 px-4">{rangeData.name}</td>
                                </tr>
                                <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold">住所</th>
                                    <td class="py-3 px-4">
                                        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(rangeData.name + " " + rangeData.address)}`} target="_blank" rel="noopener noreferrer" class="text-green-700 hover:underline">
                                            {rangeData.address}
                                        </a>
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold">電話番号</th>
                                    <td class="py-3 px-4">
                                        {rangeData.phone ? (
                                            <a href={`tel:${rangeData.phone?.replace(/-/g, "")}`} class="text-green-700 hover:underline">
                                                {rangeData.phone}
                                            </a>
                                        ) : (
                                            <span>-</span>
                                        )}
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold">営業時間</th>
                                    <td class="py-3 px-4">
                                        練習場: 平日 9:00～23:00 / 土日祝 7:00～23:00<br/>
                                        ショートコース: 9:00～21:30（最終受付 20:30頃）
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold">料金（ショートコース）</th>
                                    <td class="py-3 px-4">
                                        <strong>【練習1h＋9Hセット】</strong><br/>
                                        メンバー: 1,480円<br/>
                                        ビジター: 1,780円～<br/>
                                        <strong>【9Hのみ】</strong><br/>
                                        メンバー: 980円<br/>
                                        ビジター: 1,280円～<br/>
                                        <small>※詳細は<a href="#price" class="text-green-700 hover:underline">料金表</a>をご確認ください。</small>
                                    </td>
                                </tr>
                                 <tr class="border-b border-slate-200">
                                    <th class="py-3 px-4 bg-slate-50 font-semibold">公式サイト</th>
                                    <td class="py-3 px-4">
                                        <a href="https://365golfclub.jp/nagahama/" target="_blank" rel="noopener noreferrer" class="text-green-700 hover:underline">
                                            https://365golfclub.jp/nagahama/
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                ) : (
                    <p class="text-center text-slate-500 py-4">
                        施設情報を読み込んでいます...
                    </p>
                )
            }
            
             <p class="text-center font-bold text-lg mt-8">
                🎯 さらに詳しい営業時間・口コミ等はこちら！
                <br />
                <a
                    href={`/ranges/${rangeId}/`} 
                    class="mt-4 inline-block bg-green-700 text-white font-bold py-3 px-8 rounded-lg shadow-md hover:bg-green-800 transition-colors duration-200 text-base no-underline"
                >
                    {rangeData ? `「${rangeData.name}」のシガゴル公式レビューページへ →` : "公式レビューページへ →"}
                </a>
            </p>
        </main> 

        <Sidebar />
        
    </div>

