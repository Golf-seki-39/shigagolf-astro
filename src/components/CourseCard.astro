---
// src/components/CourseCard.astro
// 作成済みのJSONデータを読み込む
import goraLinks from '../data/gora-links.json';

// 記事側から「どのゴルフ場か？」のキー（omi, ryuoなど）を受け取る
const { courseKey } = Astro.props;

// キーを元に、JSONから該当するゴルフ場のデータを引き出す
const course = goraLinks[courseKey];

// ※もしJSONに画像や料金のデータが入っていなかった場合のエラー防止用（安全装置）
const imageUrl = course?.imageUrl || "https://placehold.jp/240x180.png?text=No+Image";
const rating = course?.rating || "確認中";
const minPrice = course?.minPrice || "---";
const reserveUrl = course?.reserveUrl || "#";
const name = course?.name || "ゴルフ場";
---

<!-- リッチカードのHTML（Tailwind CSSでスタイリング） -->
<div class="border border-gray-200 rounded-lg shadow-sm bg-white overflow-hidden flex flex-col md:flex-row mb-6 max-w-3xl mx-auto">
  
  <!-- 左側：ゴルフ場の画像 -->
  <div class="w-full md:w-2/5">
    <img src={imageUrl} alt={name} class="w-full h-48 md:h-full object-cover" />
  </div>
  
  <!-- 右側：情報とボタン -->
  <div class="w-full md:w-3/5 p-4 flex flex-col justify-between">
    <div>
      <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-2">{name}</h3>
      <p class="text-sm text-gray-600 mb-1">
        ⭐️ 総合評価: <span class="text-yellow-500 font-bold">{rating}</span>
      </p>
      <p class="text-sm text-gray-600 mb-4">
        💰 最安値プラン: <span class="text-red-600 font-bold">{minPrice}円〜</span>
      </p>
    </div>
    
    <!-- ここが5%のアフィリエイトリンク -->
    <a 
      href={reserveUrl} 
      target="_blank" 
      rel="noopener sponsored" 
      class="flex justify-center items-center w-full px-4 py-3 bg-red-600 text-white font-bold rounded-lg hover:bg-red-700 hover:shadow-md transition-all duration-200 no-underline text-sm md:text-base"
    >
      👉 楽天GORAで空き状況とプランを見る
    </a>
  </div>
</div>